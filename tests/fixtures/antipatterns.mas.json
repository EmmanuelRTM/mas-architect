{
  "name": "everything-wrong",
  "task": { "shape": "cited_report" },
  "platform": { "runtime": "claude-code-subagents", "max_concurrency": 40, "nesting_depth": 4 },
  "agents": [
    { "id": "manager", "role": "orchestrator", "model": "claude-opus-5-5", "model_family": "claude", "stateful": true, "context": "shared" },
    { "id": "writer", "role": "researcher", "count": 30, "model": "claude-opus-5-5", "model_family": "claude", "context": "shared", "stateful": true },
    { "id": "manager", "role": "worker", "model": "claude-opus-5-5", "model_family": "claude" }
  ],
  "tasks": [
    { "id": "write", "owner": "ghost" },
    { "id": "merge" }
  ],
  "communication": { "mode": "blocking", "share_full_solutions": true, "debate": true },
  "selection": { "strategy": "majority_vote", "candidates": 30, "revision_peers": 29 },
  "merge": { "input": "summaries", "agent": "manager" },
  "verification": { "judge_agents": ["writer"] },
  "routing": { "catalog_size": 5000 },
  "state": { "location": "orchestrator_context" },
  "monitoring": { "repeated_runs": 1 },
  "training": { "credit_assignment": "per_response" },
  "budget": { "expected_error_correlation": 0.9 }
}
