{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EmmanuelRTM/mas-architect/templates/spec.schema.json",
  "title": "Multi-agent system spec (.mas.json)",
  "type": "object",
  "required": [
    "name",
    "task",
    "agents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "enum": [
            "short_verifiable",
            "optimization",
            "codebase_long",
            "cited_report",
            "routing",
            "expensive_eval",
            "judgment_science"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "runtime": {
          "enum": [
            "claude-code-subagents",
            "claude-code-workflow",
            "custom"
          ]
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "nesting_depth": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency_override": {
          "type": "boolean"
        }
      }
    },
    "baseline": {
      "type": "object",
      "properties": {
        "single_agent_score": {
          "type": "number"
        },
        "metric": {
          "type": "string"
        },
        "runs": {
          "type": "integer"
        }
      }
    },
    "planning": {
      "type": "object",
      "properties": {
        "fixed_spec": {
          "type": "boolean"
        },
        "planner_ensemble": {
          "type": "integer"
        },
        "joint_exploration": {
          "type": "boolean"
        },
        "negotiated_partition": {
          "type": "boolean"
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "planner",
              "worker",
              "researcher",
              "solver",
              "orchestrator",
              "advisor",
              "manager",
              "judge",
              "verifier",
              "critic",
              "selector",
              "reviewer",
              "editor",
              "router",
              "evaluator"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "description": "Claude id or alias (opus, sonnet, haiku, fable) or another provider's id"
          },
          "model_family": {
            "type": "string"
          },
          "effort": {
            "oneOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              {
                "type": "integer"
              }
            ]
          },
          "effort_justification": {
            "type": "string"
          },
          "thinking": {
            "enum": [
              "adaptive",
              "disabled",
              "between_tools"
            ]
          },
          "max_tokens": {
            "type": "integer"
          },
          "context": {
            "enum": [
              "isolated",
              "shared"
            ]
          },
          "stateful": {
            "type": "boolean"
          },
          "memoryless": {
            "type": "boolean"
          },
          "heartbeat_seconds": {
            "type": "integer"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "start_condition",
          "done_criterion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "start_condition": {
            "type": "string"
          },
          "done_criterion": {
            "type": "string"
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "passive",
            "non_blocking",
            "blocking",
            "broadcast",
            "debate"
          ]
        },
        "share_full_solutions": {
          "type": "boolean"
        },
        "debate": {
          "type": "boolean"
        },
        "memory": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "claim_states": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "evidence_grounded",
            "bias_controlled",
            "trained_selector",
            "best_of_n_metric",
            "majority_vote",
            "plurality",
            "confidence_vote",
            "llm_aggregator"
          ]
        },
        "candidates": {
          "type": "integer",
          "minimum": 1
        },
        "revision_peers": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "merge": {
      "type": "object",
      "properties": {
        "input": {
          "enum": [
            "raw_evidence",
            "snippets",
            "summaries",
            "full_transcripts"
          ]
        },
        "agent": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "judge_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluator_protected": {
          "type": "boolean"
        },
        "real_validation_before_promotion": {
          "type": "boolean"
        },
        "held_out_audit_every": {
          "type": "integer"
        }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "location": {
          "enum": [
            "harness",
            "orchestrator_context"
          ]
        },
        "reset_policy": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "fork_and_flush",
                "session_split",
                "stateless_epochs",
                "none"
              ]
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "branches": {
              "type": "integer"
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "catalog_size": {
          "type": "integer"
        },
        "top_k": {
          "type": "integer"
        },
        "preselection": {
          "type": "string"
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "repeated_runs": {
          "type": "integer"
        },
        "belief_probes": {
          "type": "boolean"
        },
        "heartbeat": {
          "type": "boolean"
        },
        "track_cost": {
          "type": "boolean"
        }
      }
    },
    "training": {
      "type": "object",
      "properties": {
        "credit_assignment": {
          "enum": [
            "team",
            "active_set",
            "set_level",
            "per_response"
          ]
        },
        "peer_families": {
          "type": "integer"
        },
        "decorrelation": {
          "type": "boolean"
        }
      }
    },
    "human_in_the_loop": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_tokens": {
          "type": "integer"
        },
        "max_model_calls": {
          "type": "integer"
        },
        "expected_error_correlation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
