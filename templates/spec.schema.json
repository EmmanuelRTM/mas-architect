{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EmmanuelRTM/mas-architect/templates/spec.schema.json",
  "title": "Multi-agent system spec (.mas.json)",
  "type": "object",
  "required": [
    "name",
    "task",
    "agents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "enum": [
            "short_verifiable",
            "optimization",
            "codebase_long",
            "cited_report",
            "routing",
            "expensive_eval",
            "judgment_science"
          ]
        },
        "description": {
          "type": "string"
        },
        "closure_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What closure means for this task: controls, validation, delivery/feasibility, repeat-run success."
        },
        "parallelism": {
          "enum": [
            "replica",
            "structural",
            "both"
          ],
          "description": "replica = several complete solution paths; structural = concurrent parts of one path (TIPEX 2608.05791)."
        }
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "runtime": {
          "enum": [
            "claude-code-subagents",
            "claude-code-workflow",
            "custom"
          ]
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "nesting_depth": {
          "type": "integer",
          "minimum": 0
        },
        "concurrency_override": {
          "type": "boolean"
        },
        "shared_resources": {
          "type": "boolean",
          "description": "Several agents share one execution machine or account (SCARCE 2610.21029)."
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "description": "Items in a single parallel() or pipeline() call; workflows allow at most 4,096."
        }
      }
    },
    "baseline": {
      "type": "object",
      "properties": {
        "single_agent_score": {
          "type": "number"
        },
        "metric": {
          "type": "string"
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_score": {
          "type": "number",
          "description": "Ceiling of the metric, to judge how close the single agent already is."
        }
      }
    },
    "planning": {
      "type": "object",
      "properties": {
        "fixed_spec": {
          "type": "boolean"
        },
        "planner_ensemble": {
          "type": "integer"
        },
        "joint_exploration": {
          "type": "boolean"
        },
        "negotiated_partition": {
          "type": "boolean"
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Catalog of the skills this team uses. Agents may preload only names listed here.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "plugin",
                  "project",
                  "user",
                  "harness"
                ]
              }
            }
          }
        ]
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "planner",
              "worker",
              "researcher",
              "solver",
              "orchestrator",
              "advisor",
              "manager",
              "judge",
              "verifier",
              "critic",
              "selector",
              "reviewer",
              "editor",
              "router",
              "evaluator"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "description": "Claude id or alias (opus, sonnet, haiku, fable) or another provider's id"
          },
          "model_family": {
            "type": "string"
          },
          "effort": {
            "oneOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              {
                "type": "integer"
              }
            ]
          },
          "effort_justification": {
            "type": "string"
          },
          "thinking": {
            "enum": [
              "adaptive",
              "disabled",
              "between_tools"
            ]
          },
          "max_tokens": {
            "type": "integer"
          },
          "context": {
            "enum": [
              "isolated",
              "shared"
            ]
          },
          "stateful": {
            "type": "boolean"
          },
          "memoryless": {
            "type": "boolean"
          },
          "heartbeat_seconds": {
            "type": "integer"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tools granted to this agent. Keep the list short: unused tool descriptions are billed every turn."
          },
          "instructions": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*:)?[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true,
            "description": "Skills preloaded into this agent at startup (Claude Code `skills:` frontmatter). Subagents do not inherit the parent's skills. [] means none."
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "start_condition",
          "done_criterion"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "start_condition": {
            "type": "string"
          },
          "done_criterion": {
            "type": "string"
          },
          "monitor": {
            "type": "string",
            "description": "Agent id or \"harness\": the delegator that monitors progress and recovers the task (RCM 2610.21243)."
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "passive",
            "non_blocking",
            "blocking",
            "broadcast",
            "debate"
          ]
        },
        "share_full_solutions": {
          "type": "boolean"
        },
        "debate": {
          "type": "boolean"
        },
        "memory": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "claim_ledger",
                "bulletin_board",
                "shared_workspace",
                "none"
              ]
            },
            "claim_states": {
              "type": "array",
              "items": {
                "enum": [
                  "proposed",
                  "confirmed",
                  "contested",
                  "superseded"
                ]
              }
            }
          }
        },
        "gated_isolation": {
          "type": "boolean",
          "description": "Selected search tasks stay isolated from the shared board so they keep their own priors (ArcticSwarm)."
        },
        "ranking": {
          "enum": [
            "none",
            "popularity",
            "citation"
          ],
          "description": "How shared findings are ordered for readers; popularity ranking herds (2610.30769)."
        }
      }
    },
    "context_policy": {
      "type": "object",
      "description": "How each agent's context is bounded over a run (AKV 2610.28577, TokenEconomizer).",
      "properties": {
        "retained_tool_responses": {
          "type": "integer",
          "minimum": 0
        },
        "prune_unused_tools": {
          "type": "boolean"
        },
        "stale_output": {
          "enum": [
            "drop",
            "keep",
            "summarize"
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "evidence_grounded",
            "bias_controlled",
            "trained_selector",
            "best_of_n_metric",
            "majority_vote",
            "plurality",
            "confidence_vote",
            "llm_aggregator"
          ]
        },
        "candidates": {
          "type": "integer",
          "minimum": 1
        },
        "revision_peers": {
          "type": "integer",
          "minimum": 0
        },
        "dedup": {
          "type": "boolean",
          "description": "Near-duplicate candidates are dropped before selection (DAPS)."
        }
      }
    },
    "merge": {
      "type": "object",
      "properties": {
        "input": {
          "enum": [
            "raw_evidence",
            "snippets",
            "summaries",
            "full_transcripts"
          ]
        },
        "agent": {
          "type": "string"
        },
        "recall_tool": {
          "type": "boolean",
          "description": "The merger can pull snippets from a dependency's full transcript on demand (DAGent 2609.39154)."
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "judge_agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluator_protected": {
          "type": "boolean"
        },
        "real_validation_before_promotion": {
          "type": "boolean"
        },
        "held_out_audit_every": {
          "type": "integer"
        }
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "location": {
          "enum": [
            "harness",
            "orchestrator_context"
          ]
        },
        "reset_policy": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "fork_and_flush",
                "session_split",
                "stateless_epochs",
                "prune_schedule",
                "none"
              ]
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "branches": {
              "type": "integer",
              "minimum": 2
            },
            "sessions": {
              "type": "integer",
              "minimum": 2
            },
            "inflection_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "schedule": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "description": "Start-many-then-prune counts, strictly decreasing to 1, e.g. [12, 5, 2, 1]."
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "properties": {
        "catalog_size": {
          "type": "integer"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "preselection": {
          "enum": [
            "bm25",
            "index",
            "embedding",
            "none"
          ]
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "repeated_runs": {
          "type": "integer"
        },
        "belief_probes": {
          "type": "boolean"
        },
        "heartbeat": {
          "type": "boolean"
        },
        "track_cost": {
          "type": "boolean"
        },
        "commitment_log": {
          "type": "boolean",
          "description": "Every commitment an agent makes to a peer is logged for the principal."
        },
        "progress_check": {
          "enum": [
            "self_report",
            "peer_override"
          ],
          "description": "Whether a supervisor or peer can override an agent's self-reported status (Agent Status Protocol)."
        },
        "critical_path_steps": {
          "type": "boolean",
          "description": "Measure progress in critical-path steps, not total steps (Kimi K2.5 PARL)."
        }
      }
    },
    "training": {
      "type": "object",
      "properties": {
        "credit_assignment": {
          "enum": [
            "team",
            "active_set",
            "set_level",
            "per_response"
          ]
        },
        "peer_families": {
          "type": "integer"
        },
        "decorrelation": {
          "type": "boolean"
        }
      }
    },
    "human_in_the_loop": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_tokens": {
          "type": "integer"
        },
        "max_model_calls": {
          "type": "integer"
        },
        "expected_error_correlation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "expected_tokens_per_instance": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
