{
  "$schema": "../spec.schema.json",
  "name": "agent-catalog-router",
  "version": "1",
  "task": {
    "shape": "routing",
    "description": "Route each request to the right agent among thousands of agent cards.",
    "closure_criteria": [
      "routing accuracy on the held-out query set is reported over 3 runs",
      "every misroute in the audited sample is logged with the card that should have won"
    ],
    "parallelism": "replica"
  },
  "platform": {
    "runtime": "custom",
    "max_concurrency": 32,
    "max_items": 1000
  },
  "baseline": {
    "single_agent_score": 0.81,
    "metric": "routing accuracy",
    "runs": 3,
    "max_score": 1.0
  },
  "skills": [
    {
      "name": "routing-audit-rubric",
      "description": "How to judge whether a routed tool or agent fit the request",
      "source": "project"
    }
  ],
  "agents": [
    {
      "id": "router",
      "role": "router",
      "model": "claude-haiku-5-5",
      "model_family": "claude",
      "context": "isolated",
      "stateful": false,
      "effort": "low",
      "skills": []
    },
    {
      "id": "route-auditor",
      "role": "verifier",
      "model": "gpt-5.5",
      "model_family": "openai",
      "context": "isolated",
      "stateful": false,
      "memoryless": true,
      "skills": [
        "routing-audit-rubric"
      ]
    }
  ],
  "tasks": [
    {
      "id": "route",
      "owner": "router",
      "start_condition": "request arrives with top-K preselected cards",
      "done_criterion": "one agent card chosen with a one-line reason, written to the routing log",
      "monitor": "harness"
    },
    {
      "id": "audit",
      "owner": "route-auditor",
      "start_condition": "sampled 5% of routed requests",
      "done_criterion": "misroutes logged with the card that should have won and the score",
      "monitor": "harness"
    }
  ],
  "communication": {
    "mode": "none",
    "share_full_solutions": false,
    "ranking": "none"
  },
  "routing": {
    "catalog_size": 5000,
    "top_k": 20,
    "preselection": "bm25"
  },
  "verification": {
    "judge_agents": [
      "route-auditor"
    ]
  },
  "state": {
    "location": "harness"
  },
  "monitoring": {
    "repeated_runs": 3,
    "track_cost": true,
    "commitment_log": false,
    "progress_check": "self_report"
  },
  "budget": {
    "expected_error_correlation": 0.5,
    "expected_tokens_per_instance": 4000
  }
}
