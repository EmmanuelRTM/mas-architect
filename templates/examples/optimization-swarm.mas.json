{
  "$schema": "../spec.schema.json",
  "name": "kernel-optimization-swarm",
  "version": "1",
  "task": {
    "shape": "optimization",
    "description": "Optimize a kernel against an executable cycle-count score.",
    "closure_criteria": [
      "best candidate passes real validation on the held-out inputs, not only the proxy score",
      "cycle count improves over the single-agent baseline in all 3 repeated runs",
      "every scored candidate is recorded in the harness ledger with its branch"
    ],
    "parallelism": "replica"
  },
  "platform": {
    "runtime": "claude-code-workflow",
    "max_concurrency": 15,
    "nesting_depth": 1,
    "max_items": 256
  },
  "baseline": {
    "single_agent_score": 1336,
    "metric": "cycles (lower is better)",
    "runs": 3
  },
  "skills": [
    {
      "name": "search-strategy",
      "description": "How the advisor proposes directions from the leaderboard",
      "source": "project"
    },
    {
      "name": "kernel-tuning",
      "description": "Playbook for proposing and testing kernel variants",
      "source": "project"
    }
  ],
  "agents": [
    {
      "id": "advisor",
      "role": "advisor",
      "model": "claude-opus-5-5",
      "model_family": "claude",
      "context": "isolated",
      "stateful": false,
      "effort": "medium",
      "skills": [
        "search-strategy"
      ]
    },
    {
      "id": "worker",
      "role": "worker",
      "count": 3,
      "model": "claude-sonnet-5-5",
      "model_family": "claude",
      "context": "isolated",
      "stateful": false,
      "heartbeat_seconds": 120,
      "effort": "high",
      "max_tokens": 128000,
      "skills": [
        "kernel-tuning"
      ],
      "tools": [
        "Read",
        "Write",
        "Bash"
      ]
    },
    {
      "id": "worker-alt",
      "role": "worker",
      "count": 2,
      "model": "gpt-5.5",
      "model_family": "openai",
      "context": "isolated",
      "stateful": false,
      "heartbeat_seconds": 120,
      "skills": [
        "kernel-tuning"
      ],
      "tools": [
        "Read",
        "Write",
        "Bash"
      ]
    },
    {
      "id": "evaluator",
      "role": "verifier",
      "model": "deterministic",
      "model_family": "none",
      "context": "isolated",
      "stateful": false,
      "memoryless": true,
      "skills": []
    }
  ],
  "tasks": [
    {
      "id": "assign",
      "owner": "advisor",
      "start_condition": "epoch starts with harness evidence summary",
      "done_criterion": "one concrete, non-overlapping experiment per worker written to the ledger",
      "monitor": "harness"
    },
    {
      "id": "experiment",
      "owner": "worker",
      "start_condition": "assignment received",
      "done_criterion": "candidate file submitted to the evaluator, or abandoned with a logged reason",
      "monitor": "advisor"
    },
    {
      "id": "experiment-alt",
      "owner": "worker-alt",
      "start_condition": "assignment received",
      "done_criterion": "candidate file submitted to the evaluator, or abandoned with a logged reason",
      "monitor": "advisor"
    },
    {
      "id": "score",
      "owner": "evaluator",
      "start_condition": "candidate submitted",
      "done_criterion": "score recorded in harness ledger",
      "monitor": "harness"
    }
  ],
  "communication": {
    "mode": "none",
    "share_full_solutions": false,
    "ranking": "none"
  },
  "context_policy": {
    "retained_tool_responses": 12,
    "prune_unused_tools": true,
    "stale_output": "drop"
  },
  "selection": {
    "strategy": "best_of_n_metric",
    "candidates": 5,
    "revision_peers": 0
  },
  "verification": {
    "judge_agents": [
      "evaluator"
    ],
    "evaluator_protected": true,
    "real_validation_before_promotion": true,
    "held_out_audit_every": 10
  },
  "state": {
    "location": "harness",
    "reset_policy": {
      "type": "fork_and_flush",
      "checkpoints": [
        0,
        0.33,
        0.66
      ],
      "branches": 4
    }
  },
  "monitoring": {
    "repeated_runs": 3,
    "heartbeat": true,
    "track_cost": true,
    "commitment_log": false,
    "progress_check": "peer_override",
    "critical_path_steps": true
  },
  "budget": {
    "max_tokens": 1000000000,
    "expected_error_correlation": 0.4,
    "expected_tokens_per_instance": 20000000
  }
}
