{
  "$schema": "../spec.schema.json",
  "name": "deep-research-report",
  "version": "1",
  "task": {
    "shape": "cited_report",
    "description": "Long-form research report where every claim carries a citation.",
    "closure_criteria": [
      "every claim carries a citation whose snippet supports it (verifier score recorded)",
      "DRB-II score reported over 3 runs, not the best run",
      "report delivered as a file with the frozen ResearchSpec attached"
    ],
    "parallelism": "both"
  },
  "platform": {
    "runtime": "claude-code-workflow",
    "max_concurrency": 8,
    "nesting_depth": 1,
    "max_items": 64
  },
  "baseline": {
    "single_agent_score": 48.7,
    "metric": "DRB-II",
    "runs": 3,
    "max_score": 100
  },
  "planning": {
    "fixed_spec": true,
    "planner_ensemble": 3,
    "joint_exploration": false
  },
  "skills": [
    {
      "name": "report-spec-planning",
      "description": "How to turn a question into a sectioned report spec",
      "source": "project"
    },
    {
      "name": "spec-review-rubric",
      "description": "Criteria for picking the best report spec",
      "source": "project"
    },
    {
      "name": "source-search",
      "description": "Search and source-quality playbook for section research",
      "source": "project"
    },
    {
      "name": "citation-format",
      "description": "Inline citation format shared by researchers and the editor",
      "source": "project"
    },
    {
      "name": "report-style",
      "description": "House style for the final report",
      "source": "project"
    },
    {
      "name": "citation-check-rubric",
      "description": "How to verify that each citation supports its claim",
      "source": "project"
    }
  ],
  "agents": [
    {
      "id": "planner",
      "role": "planner",
      "count": 3,
      "model": "claude-opus-5-5",
      "model_family": "claude",
      "context": "isolated",
      "stateful": false,
      "effort": "high",
      "max_tokens": 128000,
      "skills": [
        "report-spec-planning"
      ]
    },
    {
      "id": "spec-judge",
      "role": "judge",
      "model": "gpt-5.5",
      "model_family": "openai",
      "context": "isolated",
      "stateful": false,
      "memoryless": true,
      "skills": [
        "spec-review-rubric"
      ]
    },
    {
      "id": "section-researcher",
      "role": "researcher",
      "count": 6,
      "model": "claude-sonnet-5-5",
      "model_family": "claude",
      "context": "isolated",
      "stateful": false,
      "heartbeat_seconds": 60,
      "effort": "high",
      "max_tokens": 128000,
      "skills": [
        "source-search",
        "citation-format"
      ],
      "tools": [
        "WebSearch",
        "WebFetch",
        "Read",
        "Write"
      ]
    },
    {
      "id": "global-editor",
      "role": "editor",
      "model": "claude-opus-5-5",
      "model_family": "claude",
      "context": "isolated",
      "stateful": false,
      "effort": "medium",
      "max_tokens": 128000,
      "skills": [
        "citation-format",
        "report-style"
      ]
    },
    {
      "id": "citation-verifier",
      "role": "verifier",
      "model": "gemini-3.1-pro",
      "model_family": "google",
      "context": "isolated",
      "stateful": false,
      "memoryless": true,
      "skills": [
        "citation-check-rubric"
      ]
    }
  ],
  "tasks": [
    {
      "id": "plan",
      "owner": "planner",
      "start_condition": "brief received",
      "done_criterion": "three candidate outlines written to spec/",
      "monitor": "harness"
    },
    {
      "id": "fix-spec",
      "owner": "spec-judge",
      "start_condition": "three outlines exist",
      "done_criterion": "ResearchSpec frozen as a file with one section per researcher",
      "monitor": "harness"
    },
    {
      "id": "research-sections",
      "owner": "section-researcher",
      "start_condition": "ResearchSpec frozen",
      "done_criterion": "each section written to its file with inline citations and raw snippets",
      "monitor": "global-editor"
    },
    {
      "id": "edit",
      "owner": "global-editor",
      "start_condition": "all sections done",
      "done_criterion": "report file coherent; edits logged and confined to owning sections",
      "monitor": "harness"
    },
    {
      "id": "verify",
      "owner": "citation-verifier",
      "start_condition": "edited draft exists",
      "done_criterion": "every claim checked against its snippet; unsupported claims listed in a file",
      "monitor": "harness"
    }
  ],
  "communication": {
    "mode": "non_blocking",
    "share_full_solutions": false,
    "memory": {
      "type": "claim_ledger",
      "claim_states": [
        "proposed",
        "confirmed",
        "contested",
        "superseded"
      ]
    },
    "gated_isolation": true,
    "ranking": "none"
  },
  "context_policy": {
    "retained_tool_responses": 12,
    "prune_unused_tools": true,
    "stale_output": "drop"
  },
  "selection": {
    "strategy": "bias_controlled",
    "candidates": 3,
    "revision_peers": 1
  },
  "merge": {
    "input": "raw_evidence",
    "agent": "global-editor",
    "recall_tool": true
  },
  "verification": {
    "judge_agents": [
      "citation-verifier",
      "spec-judge"
    ],
    "real_validation_before_promotion": true
  },
  "state": {
    "location": "harness",
    "reset_policy": {
      "type": "stateless_epochs"
    }
  },
  "monitoring": {
    "repeated_runs": 3,
    "belief_probes": false,
    "heartbeat": true,
    "track_cost": true,
    "commitment_log": true,
    "progress_check": "peer_override",
    "critical_path_steps": true
  },
  "budget": {
    "max_tokens": 1048576,
    "max_model_calls": 600,
    "expected_error_correlation": 0.5,
    "expected_tokens_per_instance": 120000
  }
}
